  "nodes": {
    "1A": {
      "kind": "start",
      "title": "Context OS",
      "sub": "ICP, personas, signals, facts.md",
      "tools": [
        "claude_code",
        "github"
      ],
      "w": 300
    },
    "1B": {
      "kind": "decision",
      "title": "Spec approved?",
      "w": 270
    },
    "nospec": {
      "kind": "exit",
      "title": "Run /build-workflow-spec first",
      "below": "1B"
    },
    "1C": {
      "kind": "step",
      "title": "Buying signals",
      "sub": [
        "U1 Finance-ops hiring",
        "U2 New finance leader",
        "U3 Headcount up 20%+",
        "U4 New country or state",
        "U5 Funding (S1 only)"
      ],
      "tools": [
        "clay",
        "n8n"
      ]
    },
    "1D": {
      "kind": "step",
      "title": "Find companies",
      "sub": "Resolve domain, one row per company",
      "tools": [
        "clay"
      ]
    },
    "1E": {
      "kind": "decision",
      "title": "In HubSpot?",
      "w": 270
    },
    "supp": {
      "kind": "exit",
      "title": "Suppress: customer, open opp or recent loss",
      "below": "1E"
    },
    "1F": {
      "kind": "step",
      "title": "Enrich",
      "sub": "Headcount, industry, ownership, ERP, incumbent tool, funding",
      "tools": [
        "clay"
      ]
    },
    "1G": {
      "kind": "decision",
      "title": "ICP fit?",
      "w": 270
    },
    "excl": {
      "kind": "exit",
      "title": "Exclude with reason. REVIEW goes to a manual queue",
      "below": "1G"
    },
    "1H": {
      "kind": "decision",
      "title": "Tier?",
      "w": 270
    },
    "1I": {
      "kind": "branch",
      "title": "Tier 1 or Tier 2",
      "sub": [
        "Tier 1: U2, U3 or U4, adds a rep task",
        "Tier 2: U1 or U5 only"
      ],
      "w": 300
    },
    "t3": {
      "kind": "exit",
      "title": "Tier 3: no live signal, held",
      "w": 300
    },
    "2A": {
      "kind": "decision",
      "title": "Segment?",
      "w": 270
    },
    "2B": {
      "kind": "branch",
      "title": "S1 Software angle",
      "sub": "Card volume, software spend",
      "w": 260
    },
    "2C": {
      "kind": "branch",
      "title": "S2 Construction angle",
      "sub": "Job-cost coding, crew cards",
      "w": 260
    },
    "2D": {
      "kind": "branch",
      "title": "S3 Healthcare angle",
      "sub": "One close across locations",
      "w": 260
    },
    "2E": {
      "kind": "step",
      "title": "Find people",
      "sub": [
        "Champion: Controller",
        "Buyer: CFO or VP Finance"
      ],
      "tools": [
        "clay"
      ]
    },
    "2F": {
      "kind": "decision",
      "title": "Still employed?",
      "w": 270
    },
    "drop": {
      "kind": "exit",
      "title": "Drop",
      "below": "2F"
    },
    "2G": {
      "kind": "step",
      "title": "Find and verify email",
      "sub": "Waterfall, two verifiers, no catch-all",
      "tools": [
        "clay"
      ]
    },
    "2H": {
      "kind": "decision",
      "title": "Email valid?",
      "w": 270
    },
    "li": {
      "kind": "exit",
      "title": "LinkedIn-only route",
      "below": "2H"
    },
    "2I": {
      "kind": "step",
      "title": "Write and QA copy",
      "sub": "/campaign-copy from spec and facts.md, then /campaign-qa",
      "tools": [
        "claude_code"
      ],
      "w": 280
    },
    "2J": {
      "kind": "decision",
      "title": "Owner approves?",
      "w": 270
    },
    "hold": {
      "kind": "exit",
      "title": "Hold",
      "below": "2J"
    },
    "3A": {
      "kind": "step",
      "title": "Send the sequence",
      "sub": "3 emails, 2 LinkedIn steps. Stop on any reply",
      "tools": [
        "Instantly"
      ],
      "tool_label": "Instantly (proposed)"
    },
    "3B": {
      "kind": "step",
      "title": "Sort replies",
      "sub": "Within 1 business day. By hand until Week 4, then n8n",
      "tools": [
        "n8n"
      ]
    },
    "o1": {
      "kind": "branch",
      "title": "Interested",
      "h": 80
    },
    "o2": {
      "kind": "branch",
      "title": "Not now, with a date",
      "h": 80
    },
    "o3": {
      "kind": "branch",
      "title": "Objection",
      "h": 80
    },
    "o4": {
      "kind": "branch",
      "title": "Wrong person or referral",
      "h": 80
    },
    "o5": {
      "kind": "branch",
      "title": "Not interested or unsubscribe",
      "h": 80
    },
    "o6": {
      "kind": "branch",
      "title": "No reply",
      "h": 80
    },
    "a1": {
      "kind": "step",
      "title": "Book meeting, create deal",
      "w": 320,
      "h": 80,
      "tools": [
        "hubspot"
      ]
    },
    "a2": {
      "kind": "step",
      "title": "Task for that date",
      "w": 320,
      "h": 80,
      "tools": [
        "hubspot"
      ]
    },
    "a3": {
      "kind": "step",
      "title": "Answer from objection table, log it",
      "w": 320,
      "h": 80
    },
    "a4": {
      "kind": "exit",
      "title": "Add the right contact, back to 2E",
      "w": 320,
      "h": 80
    },
    "a5": {
      "kind": "exit",
      "title": "Suppress (180 days or global)",
      "w": 320,
      "h": 80
    },
    "a6": {
      "kind": "exit",
      "title": "Rest 90 days, re-enter on a new signal",
      "w": 320,
      "h": 80
    },
    "3C": {
      "kind": "step",
      "title": "HubSpot record",
      "sub": "Company, contact, activity, deal with signal attribution",
      "tools": [
        "hubspot"
      ]
    },
    "3D": {
      "kind": "start",
      "title": "Weekly review",
      "sub": "Rates by signal, segment and persona. Write back to icp.md, personas.md, signal-matrix.md",
      "w": 320,
      "align": "bottom"
    }
